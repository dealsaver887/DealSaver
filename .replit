modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["zulu17", "gradle", "android-tools", "sdkmanager", "yakut"]

[userenv]

[userenv.shared]
SUPABASE_URL = "https://eozcocdnzzzttewzpnat.supabase.co/"
DEALSAVER_ADMIN_EMAIL = "JessicaR7688@yahoo.com"
